{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": [
      "bun"
    ],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "packages/agent/src/**/*.ts",
    "packages/agent/test/**/*.ts",
    "packages/coding-agent/src/**/*.ts",
    "packages/coding-agent/test/**/*.ts",
    "example/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "packages/app",
    "packages/desktop",
    "packages/ui",
    "packages/session-ui",
    "packages/kernel",
    "packages/util",
    "packages/bench"
  ],
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "根 tsconfig 只管内核那半边(agent / coding-agent / example)—— 桌面端那 7 个包各自有 tsconfig,由 turbo 分别跑。合并成一个仓库之后这两半仍然分开检查,因为它们的 lib/jsx/DOM 设置本来就不同。"
}
