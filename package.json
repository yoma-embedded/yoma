{
	"name": "my-pi",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": ["packages/ai", "packages/agent", "packages/coding-agent"],
	"scripts": {
		"test": "bun run test:agent && bun run test:coding-agent && bun run test:ai",
		"test:agent": "bun test packages/agent",
		"test:coding-agent": "bun test --cwd packages/coding-agent",
		"//test:ai": "packages/ai 是整包复用的上游代码,测试用 vitest 写的(vi.hoisted / describe.sequential 都是 vitest 专有)。别用 `bun test packages/ai` —— 那会红一片,是跑法不对而不是代码坏了。",
		"test:ai": "bun run --cwd packages/ai test",
		"typecheck": "tsc --noEmit",
		"example:01": "bun example/01-minimal-agent.ts",
		"example:02": "bun example/02-parallel-tools.ts"
	},
	"dependencies": {
		"@yoma/my-pi": "workspace:*",
		"@yoma/my-pi-coding-agent": "workspace:*",
		"@earendil-works/pi-ai": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"tsx": "^4.23.1",
		"typescript": "5.9.3"
	}
}
