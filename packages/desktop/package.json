{
  "name": "@yoma-desktop/desktop",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/yoma-embedded/yoma",
  "author": {
    "name": "Yoma"
  },
  "scripts": {
    "typecheck": "tsgo -b && tsgo -b tsconfig.preload.json && tsgo -b tsconfig.renderer.json",
    "test": "vitest run",
    "predev": "tsx ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "tsx ./scripts/prebuild.ts",
    "build": "electron-vite build && tsx ./scripts/build-mailbox.ts",
    "preview": "electron-vite preview",
    "package": "tsx ./scripts/stage-engines.ts && electron-builder --config electron-builder.config.ts",
    "package:mac": "tsx ./scripts/stage-engines.ts darwin && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "tsx ./scripts/stage-engines.ts win32 && electron-builder --win --config electron-builder.config.ts --publish never",
    "package:linux": "tsx ./scripts/stage-engines.ts linux && electron-builder --linux --config electron-builder.config.ts",
    "smoke": "tsx ./scripts/kernel-smoke.ts",
    "smoke:mailbox": "tsx ./scripts/mailbox-smoke.ts",
    "e2e:ipc": "tsx ./scripts/run-e2e.ts ipc",
    "e2e:renderer": "tsx ./scripts/run-e2e.ts renderer",
    "e2e:mailbox": "tsx ./scripts/run-e2e.ts mailbox",
    "e2e:paint": "tsx ./scripts/e2e-paint.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@zip.js/zip.js": "2.7.62",
    "effect": "4.0.0-beta.83",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "4.3.3",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.15.4",
    "@types/node": "24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "@yoma-desktop/app": "*",
    "@yoma-desktop/bench": "*",
    "@yoma-desktop/kernel": "*",
    "@yoma-desktop/ui": "*",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "electron-vite": "^5",
    "esbuild": "0.28.2",
    "solid-js": "1.9.10",
    "typescript": "~5.6.2",
    "vite": "7.1.4"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  }
}
