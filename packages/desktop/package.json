{
  "name": "@yoma-desktop/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/yoma-embedded/yoma-pi",
  "author": {
    "name": "Yoma"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build && bun ./scripts/build-mailbox.ts",
    "preview": "electron-vite preview",
    "package": "bun ./scripts/stage-engines.ts && electron-builder --config electron-builder.config.ts",
    "package:mac": "bun ./scripts/stage-engines.ts darwin && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun ./scripts/stage-engines.ts win32 && electron-builder --win --config electron-builder.config.ts --publish never",
    "package:linux": "bun ./scripts/stage-engines.ts linux && electron-builder --linux --config electron-builder.config.ts",
    "smoke": "bun ./scripts/kernel-smoke.ts",
    "smoke:mailbox": "bun ./scripts/mailbox-smoke.ts",
    "e2e:ipc": "bun ./scripts/run-e2e.ts ipc",
    "e2e:renderer": "bun ./scripts/run-e2e.ts renderer",
    "e2e:mailbox": "bun ./scripts/run-e2e.ts mailbox"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@zip.js/zip.js": "2.7.62",
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3",
    "marked": "^15"
  },
  "devDependencies": {
    "@actions/artifact": "4.0.0",
    "@lydell/node-pty": "catalog:",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "@yoma-desktop/app": "workspace:*",
    "@yoma-desktop/bench": "workspace:*",
    "@yoma-desktop/kernel": "workspace:*",
    "@yoma-desktop/ui": "workspace:*",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "electron-vite": "^5",
    "esbuild": "catalog:",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  }
}
