{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.yoma.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "node",
      "electron",
      "vite/client"
    ]
  },
  "references": [
    {
      "path": "../app"
    }
  ],
  "include": [
    "src/main",
    "src/preload/types.ts",
    "package.json"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
