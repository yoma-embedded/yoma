{
  "name": "@yoma-desktop/bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "无人值守调试台:把 job spec 交给内核跑到底,判据由 runner 亲自验,产出分支与报告",
  "bin": {
    "yoma-bench": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mailbox/paths": "./src/mailbox/paths.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.test.json",
    "test": "bun test src",
    "bench": "bun ./src/cli.ts",
    "build:eval": "bun ./scripts/build-eval-entry.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "workspace:*",
    "@yoma-desktop/kernel": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}
