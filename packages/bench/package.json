{
  "name": "@yoma-desktop/bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "无人值守调试台:把 job spec 交给内核跑到底,判据由 runner 亲自验,产出分支与报告",
  "bin": {
    "yoma-bench": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mailbox/paths": "./src/mailbox/paths.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsx ./src/cli.ts",
    "build:eval": "tsx ./scripts/build-eval-entry.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "*",
    "@yoma-desktop/kernel": "*"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "esbuild": "0.28.1",
    "typescript": "5.8.2"
  }
}
