{
  "name": "@earendil-works/pi-ai",
  "version": "0.85.1",
  "private": true,
  "description": "Unified LLM API with automatic model discovery and provider configuration",
  "type": "module",
  "license": "MIT",
  "author": "Mario Zechner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi.git",
    "directory": "packages/ai"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./compat": {
      "types": "./src/compat.ts",
      "import": "./src/compat.ts"
    },
    "./providers/*": {
      "types": "./src/providers/*.ts",
      "import": "./src/providers/*.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "import": "./src/api/*.ts"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "import": "./src/utils/*.ts"
    },
    "./oauth": {
      "types": "./src/oauth.ts",
      "import": "./src/oauth.ts"
    },
    "./bedrock-provider": {
      "types": "./src/bedrock-provider.ts",
      "import": "./src/bedrock-provider.ts"
    },
    "./bun-oauth": {
      "types": "./src/bun-oauth.ts",
      "import": "./src/bun-oauth.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@aws-sdk/client-bedrock-runtime": "catalog:",
    "@earendil-works/pi-telemetry": "workspace:*",
    "@google/genai": "catalog:",
    "@smithy/node-http-handler": "catalog:",
    "http-proxy-agent": "catalog:",
    "https-proxy-agent": "catalog:",
    "openai": "catalog:",
    "partial-json": "catalog:",
    "typebox": "catalog:",
    "@smithy/types": "catalog:"
  }
}
