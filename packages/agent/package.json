{
  "name": "@earendil-works/pi-agent-core",
  "version": "0.85.1",
  "private": true,
  "description": "General-purpose agent with transport abstraction, state management, and attachment support",
  "type": "module",
  "license": "MIT",
  "author": "Mario Zechner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi.git",
    "directory": "packages/agent"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    },
    "./harness/context": {
      "types": "./src/harness/context.ts",
      "import": "./src/harness/context.ts"
    },
    "./harness/env/nodejs": {
      "types": "./src/harness/env/nodejs.ts",
      "import": "./src/harness/env/nodejs.ts"
    },
    "./harness/runtime/reducer": {
      "types": "./src/harness/runtime/reducer.ts",
      "import": "./src/harness/runtime/reducer.ts"
    },
    "./harness/session": {
      "types": "./src/harness/session/index.ts",
      "import": "./src/harness/session/index.ts"
    },
    "./harness/session/testing": {
      "types": "./src/harness/session/testing/index.ts",
      "import": "./src/harness/session/testing/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/chord": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-telemetry": "*",
    "diff": "8.0.4",
    "ignore": "7.0.5",
    "typebox": "1.3.7",
    "yaml": "2.9.0"
  }
}
