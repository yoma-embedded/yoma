{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@tsconfig/bun/tsconfig.json",
    "../../tsconfig.yoma.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "@yoma/agent": [
        "../../packages/agent/src/index.ts"
      ],
      "@yoma/agent/node": [
        "../../packages/agent/src/node.ts"
      ],
      "@yoma/coding-agent": [
        "../../packages/coding-agent/src/index.ts"
      ],
      "@yoma/coding-agent/system-prompt": [
        "../../packages/coding-agent/src/core/system-prompt.ts"
      ],
      "@yoma/coding-agent/models": [
        "../../packages/coding-agent/src/acp/models.ts"
      ],
      "@yoma/coding-agent/resources": [
        "../../packages/coding-agent/src/core/resources.ts"
      ],
      "@earendil-works/pi-ai": [
        "../../packages/ai/dist/index.js"
      ],
      "@earendil-works/pi-ai/providers/*": [
        "../../packages/ai/dist/providers/*.js"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "kernel-alias.ts"
  ]
}