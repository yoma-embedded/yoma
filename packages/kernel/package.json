{
  "name": "@yoma-desktop/kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Yoma kernel seam: browser-safe view model + protocol + client, and the Node-side host that drives @earendil-works/pi-agent-core",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host/index.ts",
    "./host/datasheet-server": "./src/host/datasheet-server.ts",
    "./host/models": "./src/host/models.ts",
    "./host/toolchain-schema": "./src/host/domain/toolchain/schema.ts",
    "./tools/*/contract": "./src/host/tools/*/contract.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@zip.js/zip.js": "2.7.62"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run && vitest run --config vitest.domain.config.ts"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "typescript": "5.8.2"
  }
}
