.ts-dist/
node_modules/.ts-dist/
.DS_Store
*.log
.env
.env.*
packages/desktop/resources/icons/
packages/desktop/resources/*.metainfo.xml
# (合库后 engines 是仓内真目录,不能整体忽略 —— 只忽略 build.ts 生成的运行时布局)
coverage/

# engines 运行时布局由 build.ts 生成(开发期是符号链接)
engines/bin/
engines/data/

# desktop-win 当场 --dist 的产物(不入库)
/engines-dist/

# vendored pi-ai is consumed via its prebuilt dist — keep it in git
!packages/ai/dist/

!.env.example

# 工具的运行期产物:日志采集、gdb 会话转录、烧录记录
.yoma/

.idea/
.vscode/

# Claude Code 的临时工作树(harness 生成,不属于本仓)
.claude/worktrees/

# 产品 agent 技能:只在本机保留,不入库(与公开发布保持一致)
# docs/ 从前也在这一条里,2026-09-08 入库 —— CLAUDE.md 正文引用 docs/ 下的文档,
# 挡在库外意味着新克隆/换机拿到的是一份带断链的仓库。
/.agents/

# Python 字节码缓存(harbor 适配器被 import 时生成)
__pycache__/
*.pyc

# 个人本地笔记 / 上手文档 / 创业执行记录,不入库
doc_ljq_local/
docs/business/
